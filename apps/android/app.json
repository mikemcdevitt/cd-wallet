{
  "expo": {
    "name": "CD Wallet",
    "slug": "cd-wallet",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "cdwallet",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.cdwallet.app",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0A0A0B"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "CD Wallet uses the camera only to scan the pairing QR code from your computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
